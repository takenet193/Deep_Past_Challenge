{
  "mcpServers": {
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:{{GITHUB_TOKEN_ENV}}}"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "{{WORKSPACE_ABS_PATH}}"]
    }
  }
}
